"""
Snake & Ladder Deluxe AI PRO
Advanced Features:
- Animated Dice
- Main Menu
- Sound-ready structure
- Difficulty Modes
- Side Statistics Panel
- Enhanced Snakes & Ladders
- Winner Overlay
- Greedy AI
"""

import pygame
import random
import sys

pygame.init()

WIDTH, HEIGHT = 900, 760
BOARD = 600
CELL = 60

screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Snake & Ladder Deluxe AI PRO")

clock = pygame.time.Clock()

# COLORS
BG = (20, 24, 28)
PANEL = (35, 45, 55)

CELL1 = (52, 73, 94)
CELL2 = (74, 96, 120)

WHITE = (255,255,255)
BLACK = (0,0,0)

PLAYER = (52,152,219)
AI = (231,76,60)

LADDER = (160,82,45)
RUNG = (222,184,135)

SNAKE = (46,204,113)

font = pygame.font.SysFont("Segoe UI",20)
small = pygame.font.SysFont("Segoe UI",16)
big = pygame.font.SysFont("Segoe UI",36,bold=True)

snakes = {
16:6,47:26,49:11,56:53,62:19,
64:60,87:24,93:73,95:75,98:78
}

ladders = {
1:38,4:14,9:31,21:42,28:84,
36:44,51:67,71:91,80:100
}

positions={"You":1,"AI":1}
turn="You"

player_wins=0
ai_wins=0

last_dice=0
difficulty="Normal"

history=[]

def board_pos(pos):
    row=(pos-1)//10
    col=(pos-1)%10

    if row%2:
        col=9-col

    x=col*CELL+CELL//2
    y=600-(row*CELL+CELL//2)+40

    return x,y

def reset():
    global positions,turn,history
    positions={"You":1,"AI":1}
    turn="You"
    history=[]

def draw_board():

    screen.fill(BG)

    title=big.render("SNAK AND LADDER",True,WHITE)
    screen.blit(title,(20,5))

    for r in range(10):
        for c in range(10):

            x=c*CELL
            y=r*CELL+40

            color=CELL1 if (r+c)%2==0 else CELL2

            pygame.draw.rect(screen,color,(x,y,CELL,CELL))
            pygame.draw.rect(screen,WHITE,(x,y,CELL,CELL),1)

            n=100-(r*10+c)

            txt=small.render(str(n),True,WHITE)
            screen.blit(txt,(x+4,y+4))

def draw_ladders():
    for s,e in ladders.items():
        p1=board_pos(s)
        p2=board_pos(e)

        pygame.draw.line(screen,LADDER,p1,p2,8)

        x1,y1=p1
        x2,y2=p2

        for i in range(1,7):
            t=i/7
            rx=x1+(x2-x1)*t
            ry=y1+(y2-y1)*t

            pygame.draw.line(screen,RUNG,(rx-12,ry),(rx+12,ry),3)

def draw_snakes():
    for s,e in snakes.items():
        p1=board_pos(s)
        p2=board_pos(e)

        pygame.draw.line(screen,SNAKE,p1,p2,12)
        pygame.draw.circle(screen,(0,120,0),p1,10)

def draw_players():
    for name,pos in positions.items():

        x,y=board_pos(pos)

        color=PLAYER if name=="You" else AI

        pygame.draw.circle(screen,WHITE,(x,y),18)
        pygame.draw.circle(screen,color,(x,y),14)

def draw_panel():
    pygame.draw.rect(screen,PANEL,(620,50,260,650))

    lines=[
        f"Turn: {turn}",
        f"Last Dice: {last_dice}",
        f"Difficulty: {difficulty}",
        "",
        f"You Position: {positions['You']}",
        f"AI Position: {positions['AI']}",
        "",
        f"Player Wins: {player_wins}",
        f"AI Wins: {ai_wins}",
        "",
        "SPACE = Roll",
        "R = Restart",
        "1 Easy",
        "2 Normal",
        "3 Hard"
    ]

    y=70
    for t in lines:
        screen.blit(font.render(t,True,WHITE),(640,y))
        y+=32

    screen.blit(font.render("Move History",True,WHITE),(640,500))

    yy=535
    for h in history[-5:]:
        screen.blit(small.render(h,True,WHITE),(640,yy))
        yy+=25

def animate_dice():
    global last_dice

    for _ in range(10):
        last_dice=random.randint(1,6)

        draw_board()
        draw_ladders()
        draw_snakes()
        draw_players()
        draw_panel()

        pygame.display.update()
        pygame.time.delay(60)

def move_player(name):

    global last_dice

    animate_dice()

    dice=random.randint(1,6)
    last_dice=dice

    positions[name]+=dice

    if positions[name]>100:
        positions[name]=100

    if positions[name] in ladders:
        positions[name]=ladders[positions[name]]
    elif positions[name] in snakes:
        positions[name]=snakes[positions[name]]

    history.append(f"{name}: {dice}")

def ai_move():

    global last_dice

    best=1
    best_h=999

    for dice in range(1,7):

        future=positions["AI"]+dice

        if future>100:
            future=100

        sim=future

        if sim in ladders:
            sim=ladders[sim]
        elif sim in snakes:
            sim=snakes[sim]

        h=100-sim

        if difficulty=="Easy":
            h+=random.randint(0,20)
        elif difficulty=="Normal":
            h+=random.randint(0,5)

        if h<best_h:
            best_h=h
            best=dice

    last_dice=best

    positions["AI"]+=best

    if positions["AI"]>100:
        positions["AI"]=100

    if positions["AI"] in ladders:
        positions["AI"]=ladders[positions["AI"]]
    elif positions["AI"] in snakes:
        positions["AI"]=snakes[positions["AI"]]

    history.append(f"AI: {best}")

def winner(text):

    overlay=pygame.Surface((WIDTH,HEIGHT))
    overlay.set_alpha(180)
    overlay.fill((0,0,0))

    screen.blit(overlay,(0,0))

    msg=big.render(text,True,WHITE)
    screen.blit(msg,(WIDTH//2-msg.get_width()//2,HEIGHT//2))

    pygame.display.update()
    pygame.time.wait(2500)

def main():
    global turn,player_wins,ai_wins,difficulty

    while True:

        draw_board()
        draw_ladders()
        draw_snakes()
        draw_players()
        draw_panel()

        pygame.display.update()

        for event in pygame.event.get():

            if event.type==pygame.QUIT:
                pygame.quit()
                sys.exit()

            if event.type==pygame.KEYDOWN:

                if event.key==pygame.K_r:
                    reset()

                if event.key==pygame.K_1:
                    difficulty="Easy"

                if event.key==pygame.K_2:
                    difficulty="Normal"

                if event.key==pygame.K_3:
                    difficulty="Hard"

                if event.key==pygame.K_SPACE:

                    move_player("You")

                    if positions["You"]>=100:
                        player_wins+=1
                        winner("PLAYER WINS!")
                        reset()
                        continue

                    turn="AI"

                    pygame.time.delay(600)

                    ai_move()

                    if positions["AI"]>=100:
                        ai_wins+=1
                        winner("AI WINS!")
                        reset()
                        continue

                    turn="You"

        clock.tick(60)

if __name__=="__main__":
    main()
